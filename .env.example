# Prava sandbox REST API base URL
PRAVA_BASE_URL=https://sandbox.api.example-prava.com
# Prava sandbox secret key (sk_test_ prefix, never sk_live_)
PRAVA_SECRET_KEY=sk_test_0000000000000000
# OpenAI API key for agent narration and tool calls
OPENAI_API_KEY=sk-fake-0000000000000000
# OpenAI model id used by both agents
OPENAI_MODEL=gpt-5.2
# Stripe secret key (production checkout path only)
STRIPE_SECRET_KEY=sk_test_stripe0000000000
# Stripe publishable key (production checkout path only)
STRIPE_PUBLISHABLE_KEY=pk_test_stripe0000000000
# Linq API key for iMessage escalation sends
LINQ_API_KEY=linq_fake_0000000000000000
# Linq webhook signature secret for inbound reply verification
LINQ_WEBHOOK_SECRET=whsec_fake_0000000000000000
# Linq sender phone number in E.164 format
LINQ_FROM_NUMBER=+15550000000
# Escalation channel: linq | console
ESCALATION_CHANNEL=linq
# Settlement mode: sandbox | production
SETTLEMENT_MODE=sandbox
# Public base URL of the deployed agent-b service
AGENT_B_URL=https://quartermaster-agent-b.example.fly.dev
# Public base URL of the console (webhooks land at CONSOLE_URL/api/webhooks/linq)
CONSOLE_URL=http://localhost:3000
# Last 4 digits of the demo owner's phone, for display only
DEMO_PHONE_LAST4=0000
